# Copia in .env (ignorato da git) e cambia i valori.
# Attenzione: DB_PASSWORD vale solo alla PRIMA creazione dei volumi Postgres;
# con volumi gia' esistenti la password del DB non cambia.
DB_PASSWORD=password
PGADMIN_PASSWORD=admin
# Origini ammesse dal browser (CORS), separate da virgola; da cambiare se non usi localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# HTTPS con Tailscale (solo se avvii il profilo: docker compose --profile tailscale up -d).
# Genera la chiave nell'admin console di Tailscale: Settings > Keys > Generate auth key. Serve solo al primo avvio.
TS_AUTHKEY=

# Chiave API Anthropic per la lettura degli scontrini (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modello usato per gli scontrini (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Copia dei backup fuori dal server (solo con: docker compose --profile offsite up -d). Non provato.
# Esempi di RESTIC_REPOSITORY:
#   sftp:utente@nas.local:/volume1/backup/finmanager   (NAS o altro PC: serve la chiave SSH in ./offsite)
#   s3:https://s3.eu-central-003.backblazeb2.com/NOME-BUCKET   (Backblaze B2: servono anche le due chiavi sotto)
#   /mnt/disco-esterno/finmanager   (disco esterno: aggiungi il volume al servizio nel compose)
# RESTIC_PASSWORD cifra le copie: SE LA PERDI i backup non si aprono piu'. Conservala anche fuori dal server.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Chiave che cifra i segreti nel database (es. il collegamento ad Home Assistant dal Profilo).
# Generala una volta con: openssl rand -base64 32  (se la cambi, gli account HA vanno ricollegati)
APP_SECRET_KEY=
